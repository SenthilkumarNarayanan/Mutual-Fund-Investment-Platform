<?xml version="1.0" encoding="UTF-8"?>

<included>

    <!-- Service name from application.properties -->
    <springProperty
        scope="context"
        name="SERVICE_NAME"
        source="spring.application.name"
        defaultValue="unknown-service"/>

    <!-- Console logging -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | ${SERVICE_NAME} | %X{correlationId:-N/A} | %logger{36} | %msg%n</pattern>        </encoder>

    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</included>
